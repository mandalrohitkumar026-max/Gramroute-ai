# ==============================================================================
# GRAMROUTE AI — PRODUCTION ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Copy to .env.production and provide high-entropy secrets for production deployment.

# Node.js Server
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://mongodb_user:secure_password@mongo-host:27017/gramroute_ai?authSource=admin&replicaSet=rs0
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# AI Engine Microservice
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_TIMEOUT_MS=15000

# Cryptography & Security Secrets (Generate using: openssl rand -base64 32)
JWT_ACCESS_SECRET=REPLACE_WITH_HIGH_ENTROPY_BASE64_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_HIGH_ENTROPY_BASE64_KEY_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=REPLACE_WITH_HIGH_ENTROPY_COOKIE_SIGNING_SECRET

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=https://app.gramroute.ai,https://admin.gramroute.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Logging
LOG_LEVEL=info
LOG_MASK_SENSITIVE=true

# Notification & SMS Provider (Integration Pending Production Credentials)
SMS_GATEWAY_PROVIDER=MOCK_SANDBOX
SMS_GATEWAY_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
