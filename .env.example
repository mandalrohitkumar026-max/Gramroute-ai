# Root configuration reference for GramRoute AI
# Copy to backend/.env, frontend/.env, and ai-engine/.env respectively

# --- Backend Configuration (backend/.env) ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/gramroute_ai
JWT_SECRET=development_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=development_cookie_secret_key_32_chars
CORS_ORIGIN=http://localhost:5173
AI_ENGINE_URL=http://localhost:8000
LOG_LEVEL=info

# --- Frontend Configuration (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="GramRoute AI"
VITE_MAP_DEFAULT_LAT=20.5937
VITE_MAP_DEFAULT_LNG=78.9629
VITE_MAP_DEFAULT_ZOOM=5

# --- AI Engine Configuration (ai-engine/.env) ---
AI_HOST=0.0.0.0
AI_PORT=8000
AI_ENVIRONMENT=development
BACKEND_INTERNAL_URL=http://localhost:5000
LOG_LEVEL=INFO
